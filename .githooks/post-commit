#!/bin/sh
#
# Versioned Git hook. Install with:
#   python tools/install_git_hooks.py
#
# The Python collector is intentionally non-blocking for normal commits.

if command -v python >/dev/null 2>&1; then
  python tools/agent_commit_hook.py --event post-commit
elif command -v py >/dev/null 2>&1; then
  py -3 tools/agent_commit_hook.py --event post-commit
else
  echo "agent commit hook could not find python or py" >&2
  exit 0
fi

status=$?

if [ "$status" -ne 0 ]; then
  echo "agent commit hook failed with status $status; commit was already created" >&2
fi

exit 0
